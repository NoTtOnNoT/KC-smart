{
  "rules": {
    "fcm_tokens": {
      ".read": false,
      "$token_id": {
        ".read": true,
        ".write": true
      }
    },
    "reports": {
      ".read": true,
      ".write": "newData.hasChildren(['detail', 'timestamp'])"
    },
    "broadcastHistory": {
      ".read": true,
      ".write": false
    },
    "broadcastImages": {
      "$announcementId": {
        ".read": true,
        ".write": false
      }
    },
    "kcSmartStats": {
      ".read": true,
      "pageViews": {
        ".write": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      },
      "apps": {
        "$appId": {
          ".write": "$appId.matches(/^app_(0[1-9]|1[0-9]|2[0-4])$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      },
      "days": {
        "$day": {
          "pageViews": {
            ".write": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
          },
          "apps": {
            "$appId": {
              ".write": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]$/) && $appId.matches(/^app_(0[1-9]|1[0-9]|2[0-4])$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
            }
          }
        }
      }
    }
  }
}
